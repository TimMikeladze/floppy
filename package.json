{
  "name": "floppy",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "generate:releases": "tsx scripts/generate-releases-data.ts",
    "predev": "npm run generate:releases",
    "dev": "next dev",
    "prebuild": "npm run generate:releases",
    "build": "next build",
    "start": "next start",
    "lint": "bun biome check . && bun biome format .",
    "lint:fix": "bun biome check --unsafe --write . && bun biome format --write .",
    "lint:errors": "bun biome check --diagnostic-level error --unsafe .",
    "test": "bun test",
    "check": "if [ \"$CI\" = \"true\" ]; then bun run lint && bun run tsc && bun run test; else bun run lint:fix && bun run tsc && bun run test; fi",
    "postinstall": "cp node_modules/libarchive.js/dist/worker-bundle.js public/libarchive-worker.js && cp node_modules/libarchive.js/dist/libarchive.wasm public/libarchive.wasm",
    "prepare": "simple-git-hooks",
    "release": "bun run release-it"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check && git add ."
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",

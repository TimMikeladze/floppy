    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "glob": "^13.0.5",
    "postcss": "^8.5.6",
    "release-it": "^19.2.4",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.7.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
